{
  "name": "mini-checkout",
  "version": "1.0.0",
  "description": "Mini Checkout single-page application and automated browser test suite with Playwright",
  "scripts": {
    "start": "node server.js",
    "test": "playwright test",
    "test:manual": "node run-manual-tests.js",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "show-report": "playwright show-report"
  },
  "keywords": [
    "checkout",
    "playwright",
    "testing",
    "automation",
    "qa"
  ],
